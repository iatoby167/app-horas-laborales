{
  "name": "hub-de-ingresos",
  "version": "1.0.2",
  "description": "Hub personal para controlar ingresos, proyectos, cobros y horas trabajadas.",
  "private": true,
  "main": "main.cjs",
  "type": "module",
  "author": "Hub de Ingresos",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "electron tests/subscriptions-ui.cjs",
    "test:updates-ui": "electron tests/desktop-updates-ui.cjs",
    "test:workspace-ui": "electron tests/workspace-ui.cjs",
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:prueba": "electron-builder --config electron-builder.prueba.cjs --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hubdeingresos.app",
    "productName": "Hub de Ingresos",
    "asar": true,
    "files": [
      "index.html",
      "app.js",
      "data.js",
      "pdf-report.js",
      "manifest.webmanifest",
      "sw.js",
      "*.png",
      "main.cjs",
      "preload.cjs",
      "desktop-updater.cjs",
      "desktop-distribution.cjs",
      "desktop-updates.js",
      "workspace.js",
      "workspace-ui.js",
      "workspace.css",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "iatoby167",
      "repo": "app-horas-laborales",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "artifactName": "Hub-de-Ingresos-${version}-instalador-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hub de Ingresos"
    },
    "portable": {
      "artifactName": "Hub-de-Ingresos-${version}-portable-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
